@page "/weather-settings"
@using YourApp.Features.Weather.Models
@using YourApp.Features.Weather.Interfaces
@inject IWeatherPreferenceService PreferenceService
@inject ISavedLocationService SavedLocationService

<div class="weather-settings">
    <h1>Weather Settings</h1>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-@(isSuccess ? "success" : "danger") alert-dismissible fade show">
            @message
            <button type="button" class="btn-close" @onclick="() => message = null"></button>
        </div>
    }

    <div class="settings-container">
        <!-- Preferences Section -->
        <div class="settings-section">
            <h3>Display Preferences</h3>
            <form @onsubmit="SavePreferences">
                <div class="form-group">
                    <label for="tempUnit">Temperature Unit</label>
                    <select class="form-control" id="tempUnit" @bind="preferences.TemperatureUnit">
                        <option value="C">Celsius (°C)</option>
                        <option value="F">Fahrenheit (°F)</option>
                        <option value="K">Kelvin (K)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="windUnit">Wind Speed Unit</label>
                    <select class="form-control" id="windUnit" @bind="preferences.WindSpeedUnit">
                        <option value="m/s">Meter per second (m/s)</option>
                        <option value="km/h">Kilometers per hour (km/h)</option>
                        <option value="mph">Miles per hour (mph)</option>
                    </select>
                </div>

                <div class="form-group form-check">
                    <input type="checkbox" class="form-check-input" id="timeFormat" @bind="preferences.Use24HourFormat" />
                    <label class="form-check-label" for="timeFormat">
                        Use 24-hour format
                    </label>
                </div>

                <div class="form-group form-check">
                    <input type="checkbox" class="form-check-input" id="notifications" @bind="preferences.EnableNotifications" />
                    <label class="form-check-label" for="notifications">
                        Enable notifications
                    </label>
                </div>

                <div class="form-group">
                    <label for="refreshInterval">Refresh Interval (minutes)</label>
                    <input type="number" class="form-control" id="refreshInterval" @bind="preferences.RefreshIntervalMinutes" min="5" max="120" />
                </div>

                <button type="submit" class="btn btn-primary">Save Preferences</button>
            </form>
        </div>

        <!-- Saved Locations Section -->
        <div class="settings-section">
            <h3>Saved Locations</h3>
            @if (savedLocations.Any())
            {
                <div class="locations-list">
                    @foreach (var location in savedLocations)
                    {
                        <div class="location-item">
                            <div class="location-info">
                                <h5>@location.CityName, @location.Country</h5>
                                <p class="coordinates">@location.Latitude.ToString("F2"), @location.Longitude.ToString("F2")</p>
                                @if (location.IsDefault)
                                {
                                    <span class="badge bg-warning">Default</span>
                                }
                            </div>
                            <div class="location-actions">
                                <button class="btn btn-sm btn-info" @onclick="() => SetDefault(location.Id)">
                                    Set Default
                                </button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteLocation(location.Id)">
                                    Delete
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted">No saved locations yet.</p>
            }
        </div>
    </div>
</div>

<style>
.weather-settings {
    padding: 20px;
    max-width: 800px;
    margin: 0 auto;
}

.settings-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin-top: 20px;
}

.settings-section {
    background: #f8f9fa;
    padding: 20px;
    border-radius: 10px;
}

.settings-section h3 {
    margin-top: 0;
    margin-bottom: 20px;
}

.form-group {
    margin-bottom: 15px;
}

.form-group label {
    margin-bottom: 5px;
}

.locations-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.location-item {
    background: white;
    padding: 15px;
    border-radius: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid #dee2e6;
}

.location-info h5 {
    margin: 0 0 5px 0;
}

.coordinates {
    margin: 0;
    font-size: 12px;
    color: #6c757d;
}

.location-actions {
    display: flex;
    gap: 5px;
}

@media (max-width: 768px) {
    .settings-container {
        grid-template-columns: 1fr;
    }

    .location-item {
        flex-direction: column;
        align-items: flex-start;
    }

    .location-actions {
        width: 100%;
        margin-top: 10px;
    }
}
</style>

@code {
    private WeatherPreference preferences;
    private List<SavedLocation> savedLocations = new();
    private string message = "";
    private bool isSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        preferences = await PreferenceService.GetPreferencesAsync();
        savedLocations = await SavedLocationService.GetAllLocationsAsync();
    }

    private async Task SavePreferences()
    {
        try
        {
            await PreferenceService.SavePreferencesAsync(preferences);
            message = "Preferences saved successfully";
            isSuccess = true;
        }
        catch (Exception ex)
        {
            message = $"Error saving preferences: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task SetDefault(int id)
    {
        try
        {
            await SavedLocationService.SetDefaultLocationAsync(id);
            savedLocations = await SavedLocationService.GetAllLocationsAsync();
            message = "Default location updated";
            isSuccess = true;
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            isSuccess = false;
        }
    }

    private async Task DeleteLocation(int id)
    {
        try
        {
            await SavedLocationService.DeleteLocationAsync(id);
            savedLocations = await SavedLocationService.GetAllLocationsAsync();
            message = "Location deleted";
            isSuccess = true;
        }
        catch (Exception ex)
        {
            message = $"Error deleting location: {ex.Message}";
            isSuccess = false;
        }
    }
}